{
  "formatVersion": 3,
  "display-name": "${p_name}",
  "id": "${p_id}",
  "version": "${p_version}",
  "description": "${p_desc}",
  "authors": [
    "${p_author}"
  ],
  "can-load-on": {
    "client": true,
    "server": false
  },

  "meta": {
    "icon": "${p_id}:icons/icon.png"
  },

  "mixins": [
    {
      "config": "${p_id}.client.mixins.json",
      "environment": "client"
    }
  ],

  "depends": {
    "cosmic-reach": ">=0.5.7-alpha",
    "puzzle-loader-cosmic": ">=1.5.2-alpha",
    "puzzle-loader-core": ">=1.3.4-alpha"
  },

  "access-writers": [
    "${p_id}.manipulator"
  ],

  "custom": {
    "loom:injected_interfaces": {
    }
  }
}